  m_Name: SaturnInfo
  m_EditorClassIdentifier: Assembly-CSharp::CelestialBodyInfo
  bodyName: Saturn
  classification: Giant
  positionFromSun: 6th Planet
  overview: 'Saturn is the sixth planet from the Sun and the second-largest

    planet
    in the Solar System. It is a gas giant composed primarily

    of hydrogen and
    helium, best known for its extensive ring

    system made of countless particles
    of ice and rocky material.'
  keyCharacteristics: '- Famous for its extensive ring system.

    - Second-largest
    planet in the Solar System.

    - Very low average density compared with other
    planets.

    - Has a complex system of natural satellites.

    - Titan has
    a dense nitrogen-rich atmosphere.

    - Enceladus has active water-rich plumes.'
  meanRadiusKm: 58232
  meanDiameterKm: 116464
  massKg: 5.68317e+26
  meanDensityGcm3: 0.6871
  surfaceGravityMs2: 10.44
  escapeVelocityKms: 36.09
  semiMajorAxisAU: 9.537
  orbitalPeriodDays: 10755.7
  orbitalEccentricity: 0.052
  orbitalInclinationDeg: 2.486
  perihelionAU: 9.04
  aphelionAU: 10.03
  meanOrbitalVelocityKms: 9.67
  siderealRotationPeriodDays: 0.44401
  lengthOfDayHours: 10.656
  axialTiltDeg: 26.73
  atmosphericComposition: 'Primarily hydrogen and helium, with traces of methane,

    ammonia,
    water vapour and other compounds. Its atmosphere

    contains cloud bands and
    powerful atmospheric systems.'
  atmosphericPressureBar: 0
  minimumTemperatureC: 0
