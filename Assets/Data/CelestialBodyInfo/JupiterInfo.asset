  m_Name: JupiterInfo
  m_EditorClassIdentifier: Assembly-CSharp::CelestialBodyInfo
  bodyName: Jupiter
  classification: Gas Giant
  positionFromSun: 5th Planet
  overview: 'Jupiter is the largest planet in the Solar System.

    It is a gas
    giant composed primarily of hydrogen and helium.

    Its atmosphere contains
    enormous cloud bands and powerful

    storms, including the famous Great Red
    Spot.'
  keyCharacteristics: '- Largest planet in the Solar System.

    - Great Red Spot
    is a giant atmospheric storm.

    - Rapid rotation creates a noticeably flattened
    shape.

    - Powerful magnetosphere.

    - Four major Galilean moons.

    -
    Has a faint ring system.'
  meanRadiusKm: 69911
  meanDiameterKm: 139822
  massKg: 1.89813e+27
  meanDensityGcm3: 1.326
  surfaceGravityMs2: 24.79
  escapeVelocityKms: 59.5
  semiMajorAxisAU: 5.2029
  orbitalPeriodDays: 4332.59
  orbitalEccentricity: 0.0489
  orbitalInclinationDeg: 1.303
