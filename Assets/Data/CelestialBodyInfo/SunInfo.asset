  m_Script: {fileID: 11500000, guid: 04fad43e517f6154ab820b2b279d0bd4, type: 3}
  m_Name: SunInfo
  m_EditorClassIdentifier: Assembly-CSharp::CelestialBodyInfo
  bodyName: Sun
  classification: G-type Main-Sequence Star (G2V)
  positionFromSun: Central Star
  overview: 'The Sun is the central star of the Solar System.

    It is a nearly
    spherical ball of hot plasma composed

    primarily of hydrogen and helium.
    Nuclear fusion in

    its core converts hydrogen into helium and releases

    the
    energy that powers the Solar System.'
  keyCharacteristics: '- Contains approximately 99.86% of the Solar System''s mass.

    -
    Produces energy through nuclear fusion.

    - Has a core temperature of approximately
    15 million K.

    - Has a photosphere, chromosphere and corona.

    - Generates
    the solar wind and a heliospheric magnetic field.

    - Its gravity governs
    the orbits of the planets.'
  meanRadiusKm: 695.7
  meanDiameterKm: 12742
  massKg: 1.9885e+30
  meanDensityGcm3: 1.408
  surfaceGravityMs2: 274
  escapeVelocityKms: 617.7
  semiMajorAxisAU: 0
  orbitalPeriodDays: 0
  orbitalEccentricity: 0
  orbitalInclinationDeg: 0
  perihelionAU: 0
  aphelionAU: 0
  meanOrbitalVelocityKms: 0
